HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RESPONSE_BYTES=2097152
GLOBAL_CONCURRENCY=8
PER_DOMAIN_CONCURRENCY=2
SCHEDULER_ENABLED=true
NARRATIVE_RULESET_VERSION=rule-based-v1

